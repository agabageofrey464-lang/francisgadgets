# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public site URL (no trailing slash) -- used for SEO metadata, sitemap.xml,
# and robots.txt. Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed in production if product images are served from a separate
# host (e.g. a Cloudflare R2 public bucket domain) rather than the API host.
# NEXT_PUBLIC_IMAGE_HOST=images.francisgadgetstechnologies.com

# NextAuth -- secures NextAuth's own session cookie. This is independent of
# the backend's JWT_SECRET: the backend signs the access_token it issues on
# login, NextAuth just stores that opaque string inside its own session
# (encrypted with NEXTAUTH_SECRET) and replays it to the API as a bearer
# token. The two secrets never need to match.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
