# --- App ---
APP_NAME="Francis Gadgets Technologies API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# --- Database ---
# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/francis_gadgets

# --- Auth ---
# Used only by this backend to sign/verify its own access tokens. The
# frontend's NEXTAUTH_SECRET is unrelated and does not need to match this.
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
# local | s3  (use s3 with Cloudflare R2 endpoint in production)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
PUBLIC_UPLOAD_URL=http://localhost:8000/uploads
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
S3_REGION=auto

# --- Payments: Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# --- Payments: Flutterwave ---
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx
FLUTTERWAVE_ENCRYPTION_KEY=xxx
# Set this to the same value you configure as the webhook "secret hash" in the Flutterwave dashboard
FLUTTERWAVE_WEBHOOK_SECRET_HASH=change-this-webhook-hash

DEFAULT_CURRENCY=UGX

# --- Seed admin (used by scripts/seed.py) ---
SEED_ADMIN_EMAIL=admin@francisgadgetstechnologies.com
SEED_ADMIN_PASSWORD=ChangeMe123!
